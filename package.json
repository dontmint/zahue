{
  "name": "zahue",
  "version": "0.1.0",
  "private": true,
  "description": "ZaHue — Zalo PC theme switcher (macOS + Windows)",
  "license": "MPL-2.0",
  "scripts": {
    "install-theme": "node install.js install",
    "uninstall-theme": "node install.js uninstall",
    "theme:list": "node install.js list",
    "theme:status": "node install.js status",
    "theme:dawn": "node install.js install rose-pine-dawn",
    "theme:moon": "node install.js install rose-pine-moon",
    "theme:main": "node install.js install rose-pine",
    "theme:restore": "node install.js uninstall"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@electron/asar": "3.3.1",
    "fs-extra": "^11.2.0",
    "node-html-parser": "^5.4.2"
  }
}
